{
  "name": "mini-mission-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "scan": "node scripts/check-public-files.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "leaflet": "1.9.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.13.2",
    "@vitejs/plugin-vue": "6.0.7",
    "jsdom": "27.0.1",
    "typescript": "6.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.5"
  }
}
